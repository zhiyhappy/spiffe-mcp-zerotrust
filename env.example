# Copy to .env and fill in:  cp env.example .env
# `docker compose` reads .env automatically.

# ==== Public DNS / TLS (Caddy + Let's Encrypt) ====
PUBLIC_DOMAIN=spiffe.ethandemo.com
ACME_EMAIL=you@ethandemo.com

# ==== SPIFFE trust domain ====
# NOTE: also hard-coded in spire/*.conf and envoy/*.yaml. If you change it here,
# update those files too (see README "Changing the trust domain").
TRUST_DOMAIN=ethandemo.com

# ==== Microsoft Entra ID (Open WebUI OIDC SSO) ====
# Create an App Registration; add redirect URI https://<PUBLIC_DOMAIN>/oauth/microsoft/callback
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me
WEBUI_URL=https://spiffe.ethandemo.com

# ==== MCP token enforcement ====
# false: transport is secured by SPIFFE mTLS only (default, always works)
# true : MCP additionally validates the forwarded Entra access token (OBO context)
REQUIRE_ENTRA_TOKEN=false

# ==== Workload federation demo (Step B): read a secret from Azure Key Vault ====
# The federation path uses NO client secret. Set these to the Key Vault + secret the
# App's federated identity (spiffe://ethandemo.com/agent) is granted to read.
KEY_VAULT_NAME=your-keyvault-name
SECRET_NAME=demo-secret
